# Native AArch64 Darwin: stop before an if, print the compared value,
# and next into the taken branch.

require {istarget "aarch64*-*-darwin*"}

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug c additional_flags=-O0}]} {
    return -1
}

gdb_test_no_output "set startup-with-shell off"

if {![runto_main]} {
    return -1
}

# runto_main deletes breakpoints set before the run.
set compare [gdb_get_line_number "if (value > 3)"]
gdb_breakpoint $compare

gdb_test "continue" "if \\(value > 3\\)" "stop before the comparison"
gdb_test "print value" " = 7"
gdb_test "next" "taken = 1;" "next follows the true branch"
gdb_test "print taken" " = 0" "taken is still clear on the assignment"
gdb_test "next" "return taken;" "step over the assignment"
gdb_test "print taken" " = 1" "taken records the true branch"
gdb_test "continue" "exited with code 01\\\]"
