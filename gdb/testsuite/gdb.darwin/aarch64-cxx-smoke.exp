# Native AArch64 Darwin: launch, stop at main, step, and read a local.

require allow_cplus_tests
require {istarget "aarch64*-*-darwin*"}

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile {debug c++}]} {
    return -1
}

# /bin/sh is arm64e and cannot be copied out from under SIP.  Launch the
# inferior directly.
gdb_test_no_output "set startup-with-shell off"

if {![runto_main]} {
    return -1
}

gdb_test "maintenance print target-stack" \
    "native \\(Native process\\).*\n.*exec \\(Local exec file\\)" \
    "target stack has the native Darwin process target"

gdb_test "next" "answer = answer \\+ 1;"
gdb_test "print answer" " = 41"
gdb_test "step" "return answer;"
gdb_test "print answer" " = 42"
gdb_test "continue" "exited with code 052"
