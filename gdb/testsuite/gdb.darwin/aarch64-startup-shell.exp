# Native AArch64 Darwin: /bin/sh is arm64e.  GDB must say why
# startup-with-shell cannot be used, and the inferior must still run.

require {istarget "aarch64*-*-darwin*"}

standard_testfile .c

if {[prepare_for_testing "failed to prepare" $testfile $srcfile {debug}]} {
    return -1
}

gdb_test_no_output "set startup-with-shell on"
gdb_test_no_output "set pagination off"

set saw_arm64e 0
set saw_disabled 0
gdb_test_multiple "run" "arm64e shell is not used to launch the inferior" {
    -re "The shell \[^\r\n\]* is arm64e\\." {
	set saw_arm64e 1
	exp_continue
    }
    -re "startup-with-shell is now temporarily disabled" {
	set saw_disabled 1
	exp_continue
    }
    -re "exited normally.*$gdb_prompt $" {
	if {$saw_arm64e && $saw_disabled} {
	    pass $gdb_test_name
	} else {
	    fail "$gdb_test_name (arm64e=$saw_arm64e disabled=$saw_disabled)"
	}
    }
}
