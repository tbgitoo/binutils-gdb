# Native AArch64 Darwin teaching case: std::cin, then an if/else.

require allow_cplus_tests
require {istarget "aarch64*-*-darwin*"}

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug c++ additional_flags=-O0}]} {
    return -1
}

# /bin/sh is arm64e and cannot be copied out from under SIP.
# With the shell disabled, "run < file" is not interpreted as
# redirection.  An IDE delivers console input on the inferior tty.
gdb_test_no_output "set startup-with-shell off"

if {![gdb_breakpoint "main"]} {
    return -1
}
set compare [gdb_get_line_number "if (value > 3)"]
gdb_breakpoint $compare

gdb_test "run" "int value = 0;" "inferior started at main"
gdb_test_multiple "continue" "stop at the comparison after reading stdin" {
    -re "Continuing\\.\r\n" {
	send_inferior "9\n"
	exp_continue
    }
    -re "if \\(value > 3\\).*\r\n$gdb_prompt $" {
	pass $gdb_test_name
    }
}
gdb_test "print value" " = 9"
gdb_test "next" "branch = 1;" "next enters the true branch"
gdb_test "next" "return branch;" "next reaches the return"
gdb_test "print branch" " = 1"
gdb_test "continue" "exited with code 01\\\]"
